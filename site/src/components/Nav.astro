---
// На лендинге якоря локальные ('#film'), на других страницах ведут на лендинг ('/#film')
interface Props {
  base?: string;
}
const { base = '' } = Astro.props;
---

<header class="nav">
  <div class="container nav__inner">
    <a class="nav__logo" href={base ? '/' : '#top'}>AirHead</a>
    <nav class="nav__links" id="nav-links">
      <a href={`${base}#overview`}>Обзор</a>
      <a href={`${base}#film`}>Фильм</a>
      <a href={`${base}#specs`}>Характеристики</a>
    </nav>
    <div class="nav__right">
      <a class="button button--small" href={`${base}#buy`}>Купить</a>
      <button class="nav__burger" aria-label="Меню" aria-expanded="false" aria-controls="nav-links">
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(22, 22, 23, 0.8);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    height: 52px;
  }

  .nav__logo {
    font-size: 20px;
    font-weight: 600;
  }

  .nav__links {
    display: flex;
    gap: 32px;
    margin-left: auto;
  }

  .nav__links a {
    color: var(--text-2);
    font-size: 13px;
    transition: color 0.2s;
  }

  .nav__links a:hover {
    color: var(--text);
  }

  .nav__right {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .nav__burger {
    display: none;
    flex-direction: column;
    gap: 6px;
    padding: 8px 0;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .nav__burger span {
    width: 18px;
    height: 1.5px;
    border-radius: 1px;
    background: var(--text);
    transition: transform 0.3s;
  }

  .nav__burger[aria-expanded='true'] span:first-child {
    transform: translateY(3.75px) rotate(45deg);
  }

  .nav__burger[aria-expanded='true'] span:last-child {
    transform: translateY(-3.75px) rotate(-45deg);
  }

  @media (max-width: 834px) {
    .nav__logo {
      font-size: 17px;
    }

    .nav__burger {
      display: flex;
    }

    .nav__links {
      position: absolute;
      top: 52px;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      padding: 8px var(--gutter) 24px;
      background: rgba(22, 22, 23, 0.95);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      opacity: 0;
      pointer-events: none;
      transform: translateY(-8px);
      transition: opacity 0.3s, transform 0.3s;
    }

    .nav__links.is-open {
      opacity: 1;
      pointer-events: auto;
      transform: none;
    }

    .nav__links a {
      padding: 14px 0;
      font-size: 24px;
      font-weight: 600;
      color: var(--text);
    }
  }
</style>

<script>
  const burger = document.querySelector<HTMLButtonElement>('.nav__burger')!;
  const links = document.getElementById('nav-links')!;

  const setOpen = (open: boolean) => {
    burger.setAttribute('aria-expanded', String(open));
    links.classList.toggle('is-open', open);
  };

  burger.addEventListener('click', () => setOpen(burger.getAttribute('aria-expanded') !== 'true'));
  links.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
</script>
