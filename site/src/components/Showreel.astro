---
import { url } from '../lib/url';
---

<section class="showreel" id="film">
  <div class="container showreel__inner">
    <h2 class="h-section" data-fade>Фильм, снятый<br />в полном вакууме.</h2>
    <!-- Видео запускается, когда попадает в экран (см. animations.js) -->
    <video
      class="showreel__frame"
      src={url('/video/showreel.mp4')}
      poster={url('/video/showreel-poster.jpg')}
      muted
      loop
      playsinline
      preload="metadata"
      aria-label="Шоурил: шлем AirHead крупным планом и в обороте"
      data-reel
    ></video>
  </div>
</section>

<style>
  .showreel {
    padding-top: 200px;
  }

  .showreel__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 48px;
  }

  .showreel__frame {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius);
    background: var(--placeholder);
  }

  @media (max-width: 834px) {
    .showreel {
      padding-top: 120px;
    }

    .showreel__inner {
      gap: 28px;
    }
  }
</style>
