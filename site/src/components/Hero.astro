---
import { Image } from 'astro:assets';
import helmetHero from '../assets/helmet-hero.webp';
---

<section class="hero" id="overview">
  <div class="hero__text">
    <p class="eyebrow" data-hero>Новинка</p>
    <h1 class="hero__title gradient-text" data-hero>AirHead</h1>
    <p class="hero__slogan" data-hero>Голова в облаках. <br class="hero__br" />Официально.</p>
  </div>

  <div class="hero__media">
    <Image
      src={helmetHero}
      alt="Шлем AirHead в три четверти, на визоре — интерфейс"
      class="hero__img vignette"
      widths={[390, 780, 1200, 1600, 2400]}
      sizes="(max-width: 834px) 100vw, 1200px"
      loading="eager"
      fetchpriority="high"
      data-hero-img
    />
  </div>

  <div class="hero__cta" data-hero>
    <div class="hero__row">
      <a class="button" href="#buy">Купить</a>
      <a class="link" href="#film">Смотреть фильм&nbsp;&nbsp;›</a>
    </div>
    <p class="hero__price">от 384 400 ₽ · доставка на орбиту отдельно</p>
  </div>
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 56px;
    padding-top: 120px;
    text-align: center;
    overflow: hidden;
  }

  .hero__text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .hero__title {
    font-size: clamp(72px, 10vw, 144px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .hero__slogan {
    font-size: clamp(24px, 2.5vw, 36px);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .hero__br {
    display: none;
  }

  .hero__media {
    width: 100%;
    max-width: 1200px;
  }

  .hero__img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .hero__cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .hero__row {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .hero__price {
    color: var(--text-2);
    font-size: 14px;
  }

  @media (max-width: 834px) {
    .hero {
      gap: 24px;
      padding-top: 64px;
    }

    .hero__br {
      display: inline;
    }

    .hero__img {
      aspect-ratio: 390 / 360;
    }

    .hero__row {
      gap: 24px;
    }

    .hero__price {
      font-size: 12px;
    }
  }
</style>
