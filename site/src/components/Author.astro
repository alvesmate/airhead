---
const links = [
  { label: 'Telegram', href: 'https://t.me/alvesmate' },
  { label: 'Behance', href: 'https://www.behance.net/alexveselofff' },
  { label: 'Figma', href: 'https://www.figma.com/design/Wgls51c1qAQWYINYfTv7pL/Brand-Prizrak?node-id=317-666' },
];
// TODO: когда появится страница-кейс, вести «Как это сделано» на неё
const howItsMade = 'https://github.com/alvesmate/airhead';
---

<section class="author">
  <div class="container">
    <div class="author__card" data-fade>
      <h2 class="author__title">Продукт выдуман.<br />Автор — нет.</h2>
      <div class="author__info">
        <p class="eyebrow author__eyebrow">Design &amp; code</p>
        <p class="author__name">Alex Veselov</p>
        <p class="author__bio">Графический дизайнер, который собирает свои идеи кодом.</p>
        <div class="author__links">
          <a class="link" href={howItsMade} target="_blank" rel="noopener">Как это сделано&nbsp;&nbsp;→</a>
          {
            links.map((l) => (
              <a class="author__link" href={l.href} target="_blank" rel="noopener">
                {l.label}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .author {
    padding-top: 240px;
  }

  .author__card {
    display: flex;
    align-items: center;
    gap: 64px;
    padding: 64px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius);
    background: #0a0a0b;
  }

  .author__title {
    flex: 0 0 520px;
    font-size: 48px;
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.02em;
  }

  .author__info {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .author__eyebrow {
    font-size: 14px;
  }

  .author__name {
    font-size: 32px;
    font-weight: 600;
  }

  .author__bio {
    max-width: 480px;
    color: var(--text-2);
    font-size: 19px;
    line-height: 1.5;
  }

  .author__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px;
  }

  .author__link {
    color: var(--text-2);
    font-size: 17px;
    transition: color 0.2s;
  }

  .author__link:hover {
    color: var(--text);
  }

  @media (max-width: 1100px) {
    .author__title {
      flex-basis: auto;
      font-size: 40px;
    }
  }

  @media (max-width: 834px) {
    .author {
      padding-top: 140px;
    }

    .author__card {
      flex-direction: column;
      align-items: flex-start;
      gap: 28px;
      padding: 32px 28px;
    }

    .author__title {
      font-size: 32px;
    }

    .author__info {
      gap: 12px;
    }

    .author__eyebrow {
      font-size: 13px;
    }

    .author__name {
      font-size: 24px;
    }

    .author__bio {
      font-size: 17px;
    }

    .author__links {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }

    .author__link {
      font-size: 15px;
    }
  }
</style>
